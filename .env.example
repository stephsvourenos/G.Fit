# Copy this file to `.env.local` and fill in values when each phase asks for them.
# NEVER commit .env.local. NEVER paste secret values into chat.
# Anything left blank runs as a clearly-labelled MOCK (not live).

APP_ENV=local                 # local | test | staging | production
NEXT_PUBLIC_BRAND_NAME=PROJECT_NAME

# --- Phase 1: Supabase -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=     # public: https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY= # public (safe in apps; Row-Level Security protects data)
SUPABASE_SERVICE_ROLE_KEY=    # SECRET — server only, never in mobile or browser code

# --- Phase 2: Mux ------------------------------------------------------
MUX_TOKEN_ID=                 # SECRET
MUX_TOKEN_SECRET=             # SECRET
MUX_SIGNING_KEY_ID=           # for signed playback tokens
MUX_SIGNING_PRIVATE_KEY=      # SECRET (base64)
MUX_WEBHOOK_SECRET=           # SECRET

# --- Phase 3: Stripe (TEST MODE keys only until launch) ----------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=  # pk_test_...
STRIPE_SECRET_KEY=            # SECRET sk_test_... (live keys are refused outside production)
STRIPE_WEBHOOK_SECRET=        # SECRET whsec_...

# --- Security -----------------------------------------------------------
PIN_PEPPER=                   # SECRET random string; required in production
